# Copy to .env and use the SMTP settings provided by your email service.
# Credentials stay on this computer; never enter them in the website.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Your Name

# Optional additional mailboxes. Each needs its own app password.
# HOST, PORT, SECURITY default to Gmail / 587 / starttls for these two accounts.
SMTP_2_USER=second@gmail.com
SMTP_2_PASSWORD=
SMTP_3_USER=third@gmail.com
SMTP_3_PASSWORD=
